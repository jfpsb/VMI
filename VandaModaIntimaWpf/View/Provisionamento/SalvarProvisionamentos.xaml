<View:ACadastrarView x:Class="VandaModaIntimaWpf.View.Provisionamento.SalvarProvisionamentos"
                     x:Name="TelaSalvarProvisionamentos"
                     xmlns:View="clr-namespace:VandaModaIntimaWpf.View"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:VandaModaIntimaWpf.View.Provisionamento"
                     mc:Ignorable="d"
                     WindowStartupLocation="CenterScreen"
                     WindowState="Maximized"
                     Title="Salvar Provisionamentos"
                     Height="650"
                     Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Content="Selecionar Arquivo CSV do FGTS" />
        <Button Grid.Column="1"
                Content="Procurar"
                Width="100"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Left"
                Padding="5"
                FontWeight="Bold"
                FontSize="14"
                Command="{Binding ImportarCSVComando}"
                CommandParameter="{Binding ElementName=TelaSalvarProvisionamentos}"/>
        <DataGrid Grid.Row="1"
                  Grid.ColumnSpan="2"
                  ItemsSource="{Binding Entidades, UpdateSourceTrigger=PropertyChanged}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource funcionario_header}"
                                    IsReadOnly="True"
                                    Binding="{Binding Funcionario.Nome, StringFormat='C', ConverterCulture=pt-BR}"
                                    Width="*" />

                <DataGridTextColumn Header="Salário Base"
                                    IsReadOnly="True"
                                    Binding="{Binding SalarioBase, StringFormat='C', ConverterCulture=pt-BR}"
                                    Width="*" />

                <DataGridTextColumn Header="Última Remuneração"
                                    IsReadOnly="True"
                                    Binding="{Binding UltimaRemuneracao, StringFormat='C', ConverterCulture=pt-BR}"
                                    Width="*" />

                <DataGridTextColumn Header="Aviso Prévio"
                                    IsReadOnly="True"
                                    Binding="{Binding AvisoPrevio, StringFormat='C', ConverterCulture=pt-BR}"
                                    Width="*" />

                <DataGridTextColumn Header="Décimo Terceiro"
                                    IsReadOnly="True"
                                    Binding="{Binding DecimoTerceiro, StringFormat='C', ConverterCulture=pt-BR}"
                                    Width="*" />

                <DataGridTextColumn Header="Multa do FGTS"
                                    IsReadOnly="True"
                                    Binding="{Binding MultaFgts, StringFormat='C', ConverterCulture=pt-BR}"
                                    Width="*" />

                <DataGridTextColumn Header="Provisionamento Total"
                                    IsReadOnly="True"
                                    Binding="{Binding ProvisionamentoTotal, StringFormat='C', ConverterCulture=pt-BR}"
                                    Width="*" />
            </DataGrid.Columns>

        </DataGrid>

        <Button Grid.Row="2"
                Grid.ColumnSpan="2"                
                Width="150"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                Padding="10"
                FontWeight="Bold"
                FontSize="18"
                Content="{DynamicResource salvar}"
                Style="{StaticResource BotaoCadastrar}"
                Command="{Binding SalvarComando}" />
    </Grid>
</View:ACadastrarView>
