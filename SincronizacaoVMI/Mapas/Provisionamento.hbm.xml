<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="SincronizacaoVMI"
                   namespace="SincronizacaoVMI.Model">

	<class name="Provisionamento" table="provisionamento">
		<id name="Id" type="Int32">
			<generator class="native" />
		</id>
		<property name="Uuid" />
		<many-to-one name="Funcionario" class="SincronizacaoVMI.Model.Funcionario" column="funcionario" lazy="false" />
		<many-to-one name="Loja" class="SincronizacaoVMI.Model.Loja" column="loja" lazy="false" />
		<property name="Ano" />
		<property name="Mes" />
		<property name="UltimaRemuneracao" />
		<property name="SalarioBase" />
		<property name="AvisoPrevio" />
		<property name="DecimoTerceiro" />
		<property name="MultaFgts" />
		<property name="CriadoEm" />
		<property name="ModificadoEm" />
		<property name="DeletadoEm" />
		<property name="Deletado" />
	</class>

</hibernate-mapping>
